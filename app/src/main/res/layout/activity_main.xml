<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- TOP BAR -->
    <ImageView
        android:id="@+id/notesListButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_recent_history"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintBottom_toBottomOf="@id/notesListButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/voiceSettingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_manage"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <ImageView
        android:id="@+id/fileSummaryButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_view"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintStart_toEndOf="@id/notesListButton" />

    <!-- CENTER ORB & STATE -->
    <com.user.jarvis.ParticleSphereView
        android:id="@+id/particleOrb"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listening..."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/particleOrb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:id="@+id/gamingStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/gamingStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gaming Mode: OFF"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/aimAssistStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aim Assist: OFF"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/gamingModeToggleBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Gaming"
            android:textSize="10sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />
    </LinearLayout>

    <!-- CHAT UI (Dynamic scrollable list) -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gamingStatusContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <!-- Hidden old text views for logic compatibility -->
            <TextView
                android:id="@+id/youSaidText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/jarvisReplyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- HIDDEN VIEWS PRESERVED FOR LOGIC COMPATIBILITY -->
    <View android:id="@+id/statusDot" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/statusLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <!-- BOTTOM CONTROLS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/securityModeButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintTop_toTopOf="@id/micButton"
            app:layout_constraintEnd_toStartOf="@id/micButton"
            android:layout_marginEnd="32dp" />

        <FrameLayout
            android:id="@+id/micButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <!-- Outer glowing ring / background -->
            <View
                android:id="@+id/micGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mic_glow_bg"
                android:alpha="1.0" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Use old jarvisToggleButton ID -->
        <Button
            android:id="@+id/jarvisToggleButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text=""
            android:background="@drawable/bg_circle_button"
            android:drawableTop="@android:drawable/ic_menu_edit"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintTop_toTopOf="@id/micButton"
            app:layout_constraintStart_toEndOf="@id/micButton"
            android:layout_marginStart="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
