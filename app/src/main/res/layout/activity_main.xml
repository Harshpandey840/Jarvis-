<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- TOP HEADER -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS INITIALIZED"
        android:textColor="@color/accent_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-condensed-medium"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- SYSTEM GAUGES (Top cluster) -->
    <LinearLayout
        android:id="@+id/systemGaugesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">

        <com.user.jarvis.GaugeView
            android:id="@+id/gaugeCpu"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp" />

        <com.user.jarvis.GaugeView
            android:id="@+id/gaugeRam"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp" />

        <com.user.jarvis.GaugeView
            android:id="@+id/gaugeBattery"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp" />

        <com.user.jarvis.GaugeView
            android:id="@+id/gaugeStorage"
            android:layout_width="60dp"
            android:layout_height="60dp" />
    </LinearLayout>

    <!-- CENTER CORE -->
    <com.user.jarvis.JarvisCoreView
        android:id="@+id/particleOrb"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toBottomOf="@id/systemGaugesContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- DYNAMIC STATUS TEXT -->
    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYSTEM ONLINE"
        android:textColor="@color/text_highlight"
        android:textSize="20sp"
        android:fontFamily="sans-serif-condensed-medium"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/particleOrb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- WAVEFORM (Centered below status) -->
    <com.user.jarvis.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="120dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- GAMING & SYSTEM MODULES COMPACT -->
    <LinearLayout
        android:id="@+id/modulesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/waveformView"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/gamingStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GAMING: OFF"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/gamingGameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GAME: NONE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/gamingOptimizationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPT: NONE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/aimAssistStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIM ASSIST: OFF"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <Button
                android:id="@+id/gamingModeToggleBtn"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:text="GAMING"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:background="@drawable/bg_circle_button"
                android:textColor="@color/accent_primary"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/aimAssistToggleBtn"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:text="CROSSHAIR"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:background="@drawable/bg_circle_button"
                android:textColor="@color/accent_primary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/systemSettingsStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/modulesContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/systemSettingsStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYS SETTINGS: DENIED"
            android:textColor="@color/stop_red"
            android:textSize="10sp"
            android:fontFamily="sans-serif-condensed"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/systemSettingsEnableBtn"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="ENABLE"
            android:textSize="8sp"
            android:background="@drawable/bg_circle_button"
            android:textColor="@color/accent_primary" />
    </LinearLayout>

    <!-- CHAT UI -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/systemSettingsStatusContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <!-- Hidden old text views for logic compatibility -->
            <TextView
                android:id="@+id/youSaidText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/jarvisReplyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- HIDDEN VIEWS PRESERVED FOR LOGIC COMPATIBILITY -->
    <View android:id="@+id/statusDot" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/statusLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <!-- BOTTOM CONTROLS -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/securityModeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_secure"
            app:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintTop_toTopOf="@id/micButton"
            app:layout_constraintEnd_toStartOf="@id/micButton"
            android:layout_marginEnd="32dp" />

        <ImageView
            android:id="@+id/voiceSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/securityModeButton"
            app:layout_constraintEnd_toStartOf="@id/micButton"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/notesListButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/jarvisToggleButton"
            app:layout_constraintStart_toEndOf="@id/micButton"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/fileSummaryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="@color/text_secondary"
            android:background="@drawable/bg_circle_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/voiceSettingsButton"
            app:layout_constraintEnd_toStartOf="@id/micButton"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:id="@+id/micButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <!-- Outer glowing ring / background -->
            <View
                android:id="@+id/micGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mic_glow_bg"
                android:alpha="1.0" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Use old jarvisToggleButton ID -->
        <Button
            android:id="@+id/jarvisToggleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text=""
            android:background="@drawable/bg_circle_button"
            android:drawableTop="@android:drawable/ic_media_play"
            app:layout_constraintBottom_toBottomOf="@id/micButton"
            app:layout_constraintTop_toTopOf="@id/micButton"
            app:layout_constraintStart_toEndOf="@id/micButton"
            android:layout_marginStart="32dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
