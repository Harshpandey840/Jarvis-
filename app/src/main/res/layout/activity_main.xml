<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- TOP BAR -->
    <ImageView
        android:id="@+id/notesListButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_recent_history"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jarvis"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintBottom_toBottomOf="@id/notesListButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/voiceSettingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_manage"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp" />

    <ImageView
        android:id="@+id/apiKeyButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintEnd_toStartOf="@id/voiceSettingsButton" />

    <ImageView
        android:id="@+id/fileSummaryButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_view"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/notesListButton"
        app:layout_constraintStart_toEndOf="@id/notesListButton" />

    <!-- CENTER ORB -->
    <com.user.jarvis.ParticleSphereView
        android:id="@+id/particleOrb"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />

    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listening..."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/particleOrb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- CHAT UI -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/stateLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/youSaidText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hey Jarvis, can you call Kate?"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_chat_user"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/jarvisReplyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling Kate Bell."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_chat_jarvis"
            android:layout_gravity="start"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- HIDDEN VIEWS PRESERVED FOR LOGIC COMPATIBILITY -->
    <View android:id="@+id/statusDot" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/statusLabel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <!-- BOTTOM CONTROLS -->
    <ImageView
        android:id="@+id/securityModeButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="16dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        app:tint="@color/text_secondary"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/micButton"
        app:layout_constraintTop_toTopOf="@id/micButton"
        app:layout_constraintEnd_toStartOf="@id/micButton"
        android:layout_marginEnd="32dp" />

    <FrameLayout
        android:id="@+id/micButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <!-- Outer glowing ring / background -->
        <View
            android:id="@+id/micGlow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mic_glow_bg"
            android:alpha="0.8" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_primary" />
    </FrameLayout>

    <!-- Map old jarvisToggleButton functionality to a secondary button layout -->
    <Button
        android:id="@+id/jarvisToggleButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text=""
        android:background="@drawable/status_card_bg"
        android:backgroundTint="@color/surface_card"
        android:drawableTop="@android:drawable/ic_media_play"
        app:layout_constraintBottom_toBottomOf="@id/micButton"
        app:layout_constraintTop_toTopOf="@id/micButton"
        app:layout_constraintStart_toEndOf="@id/micButton"
        android:layout_marginStart="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
