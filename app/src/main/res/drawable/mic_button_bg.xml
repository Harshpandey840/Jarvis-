<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A2830" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#00E5FF"
                android:endColor="#0097A7" />
        </shape>
    </item>
</layer-list>
